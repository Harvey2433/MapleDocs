# This file is loaded inside Nginx's http {} context on a standard Arch setup.
# Replace docs.example.internal and the certificate paths before enabling it.

map $http_upgrade $mapledocs_connection {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name docs.example.internal;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name docs.example.internal;

    ssl_certificate /etc/letsencrypt/live/docs.example.internal/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/docs.example.internal/privkey.pem;

    client_max_body_size 110m;

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mapledocs_connection;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}
