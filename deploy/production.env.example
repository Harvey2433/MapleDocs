# Generate deploy/production.env with deploy/init-production-env.sh, or copy
# this file and replace every CHANGE_ME value manually.
# Use one DNS name for both LAN and IPv6 access. TLS terminates at host Nginx.

DOCS_HOST=docs.example.internal
MAPLEDOCS_HTTP_BIND=127.0.0.1
MAPLEDOCS_HTTP_PORT=8083
APP_CONTAINER_UID=1000

# Django
DJANGO_SETTINGS_MODULE=impress.settings
DJANGO_CONFIGURATION=Production
DJANGO_ALLOWED_HOSTS=docs.example.internal
DJANGO_CSRF_TRUSTED_ORIGINS=https://docs.example.internal
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_64_HEX
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_URL_APP=https://docs.example.internal
LOGGING_LEVEL_HANDLERS_CONSOLE=ERROR
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO
PYTHONPATH=/app

# Dedicated PostgreSQL container
POSTGRES_DB=docs
POSTGRES_USER=docs
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_64_HEX

# Private MinIO container. Browser access continues through /media/ on Docs.
MINIO_ROOT_USER=mapledocs
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_64_HEX
BUCKET_NAME=docs-media-storage
S3_HOST=minio:9000
S3_INTERNAL_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
MEDIA_BASE_URL=https://docs.example.internal

# Local accounts are the default. OIDC can be configured later.
OIDC_ENABLED=false
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_REGISTRATION_ENABLED=true
LOGIN_REDIRECT_URL=https://docs.example.internal
LOGIN_REDIRECT_URL_FAILURE=https://docs.example.internal
LOGOUT_REDIRECT_URL=https://docs.example.internal
OIDC_REDIRECT_ALLOWED_HOSTS=["https://docs.example.internal"]

# Document behavior
CONVERSION_UPLOAD_ENABLED=true
CONVERSION_FILE_EXTENSIONS_ALLOWED=[".doc",".docx",".md"]
CONVERSION_FILE_MAX_SIZE=104857600
COMMENTS_ENABLED=false
CLIENT_MAX_BODY_SIZE=110m

# ONLYOFFICE. These two values must be identical and at least 32 characters.
ONLYOFFICE_ENABLED=true
ONLYOFFICE_HOST=onlyoffice
ONLYOFFICE_DOCUMENT_SERVER_URL=https://docs.example.internal/onlyoffice
ONLYOFFICE_DOCUMENT_SERVER_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_CALLBACK_BASE_URL=http://backend:8000
ONLYOFFICE_JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
JWT_SECRET=CHANGE_ME_SAME_AS_ONLYOFFICE_JWT_SECRET

# Collaboration
YPROVIDER_HOST=y-provider
Y_PROVIDER_API_BASE_URL=http://y-provider:4444/api/
Y_PROVIDER_API_KEY=CHANGE_ME_RANDOM_64_HEX
COLLABORATION_SERVER_SECRET=CHANGE_ME_RANDOM_64_HEX
COLLABORATION_SERVER_ORIGIN=https://docs.example.internal
COLLABORATION_API_URL=http://y-provider:4444/collaboration/api/
COLLABORATION_BACKEND_BASE_URL=http://backend:8000
COLLABORATION_WS_URL=wss://docs.example.internal/collaboration/ws/
COLLABORATION_LOGGING=true

# Internal gateway service names
BACKEND_HOST=backend
FRONTEND_HOST=frontend
